# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
DB_PASSWORD=kuchli-parol
PORT=8080
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# The admin panel has its own logins (not the players' Google/Telegram): the first admin, made once on start.
# More admins are added in the panel (Adminlar). Password at least 8 characters.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
# Payments (inpay.uz, kassa settings): the merchant id and token. Written here on the server, never sent in a chat.
# inPAY calls back PUBLIC_URL/api/shop/inpay, so PUBLIC_URL must be the site's https address.
INPAY_MERCHANT_ID=
INPAY_MERCHANT_TOKEN=
# Behind nginx with HTTPS on the VPS:
# PUBLIC_URL=https://avtodrom.example.uz
# TRUST_PROXY=1
# Local testing only: log in by name. NEVER on a public server.
# DEV_LOGIN=1
