# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.
DB_PASSWORD=kuchli-parol
PORT=8080
# Admin login: admin / 1234 on the first start (the panel asks for a new password at once); kept in Postgres.
# Google, Telegram and inPAY keys: admin panel, Sozlamalar > Integratsiyalar (kept in Postgres, not here).
# inPAY calls back PUBLIC_URL/api/shop/inpay, so PUBLIC_URL must be the site's https address.
# Behind nginx with HTTPS on the VPS:
# PUBLIC_URL=https://avtodrom.example.uz
# TRUST_PROXY=1
# Local testing only: log in by name. NEVER on a public server.
# DEV_LOGIN=1
