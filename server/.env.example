# Copy to .env and fill in. Never commit .env (it holds the bot token and the database password).

# PostgreSQL connection
DATABASE_URL=postgres://avtodrom:PAROL@localhost:5432/avtodrom?sslmode=disable

# Address the server listens on (nginx forwards to it)
ADDR=127.0.0.1:8080

# Google login: the OAuth "Web application" client ID (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# Telegram login: the bot from @BotFather (its token and its username without @)
TELEGRAM_BOT_TOKEN=123456789:AA...
TELEGRAM_BOT_NAME=avtodrom_uz_bot

# Who is an admin from the first login: tg:<telegram id>, google:<email>; comma separated
ADMINS=tg:123456789,google:axadjonovsardorbeck@gmail.com

# The sites allowed to call the API (the simulator's address); * allows any
CORS_ORIGINS=https://axadjonovsardorbek.github.io

# Where uploaded advertising is kept
UPLOAD_DIR=/var/lib/avtodrom/uploads

# The server's own public address (links to uploaded ads); empty: taken from the request
PUBLIC_URL=https://api.example.uz

# Behind nginx: trust its X-Forwarded-For / X-Forwarded-Proto
TRUST_PROXY=1

# Optional: also serve the built simulator (the dist folder) from this server
# STATIC_DIR=/var/www/avtodrom

# Local testing only: log in by name without Google or Telegram. NEVER on a public server.
# DEV_LOGIN=1
